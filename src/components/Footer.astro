---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-inner">
		<p class="footer-name">Nicolás Siciliano <span class="muted">/ Full-stack developer</span></p>
		<nav aria-label="Footer navigation">
			<a href="/work/">Work</a>
			<a href="/about/">About</a>
			<a href="mailto:nhsiciliano@gmail.com">Email</a>
		</nav>
		<p class="mono muted">© {year}</p>
	</div>
</footer>

<style>
	.site-footer { border-top: 1px solid var(--line); }
	.footer-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; min-height: 7rem; padding-block: 2rem; }
	.footer-name { font-size: .9rem; font-weight: 600; }
	.footer-inner nav { display: flex; gap: 1.5rem; }
	.footer-inner nav a { color: var(--ink-soft); font-size: .85rem; text-decoration: none; }
	.footer-inner nav a:hover { color: var(--accent); }
	@media (max-width: 650px) { .footer-inner { align-items: flex-start; flex-direction: column; } }
</style>
