---
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const {
	title = 'Nicolás Siciliano | Full-stack developer',
	description = 'Nicolás Siciliano builds thoughtful digital products, complex web applications, and clear interfaces for ambitious teams.',
} = Astro.props;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="theme-color" content="#12191b" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<script is:inline>
	(() => {
		const preference = () => {
			try {
				const stored = localStorage.getItem('theme');
				if (stored === 'dark' || stored === 'light') return stored;
			} catch {}
			return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		};
		const applyTheme = () => {
			const root = document.documentElement;
			const dark = preference() === 'dark';
			root.classList.add('js');
			root.classList.toggle('motion-ok', !window.matchMedia('(prefers-reduced-motion: reduce)').matches);
			root.classList.toggle('theme-dark', dark);
			document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#12191b' : '#f1f2f1');
		};
		applyTheme();
		if (!window.__themeSwapReady) {
			window.__themeSwapReady = true;
			document.addEventListener('astro:after-swap', applyTheme);
		}
	})();
</script>
