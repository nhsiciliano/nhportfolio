---
import ThemeToggle from './ThemeToggle.astro';

const links = [
	{ label: 'Home', href: '/' },
	{ label: 'Work', href: '/work/' },
	{ label: 'About', href: '/about/' },
];
const current = (href: string) => href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href);
---

<header class="site-header">
	<div class="container nav-bar">
		<a class="brand" href="/">
			<span class="brand-mark" aria-hidden="true">NS</span>
			<span class="brand-name">Nicolás<br />Siciliano</span>
		</a>
		<nav class="desktop-nav" aria-label="Main navigation">
			{links.map(({ label, href }) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
		</nav>
		<div class="desktop-actions">
			<a href="https://github.com/nhsiciliano" target="_blank" rel="noopener noreferrer">GitHub</a>
			<a href="https://linkedin.com/in/nicolashsiciliano" target="_blank" rel="noopener noreferrer">LinkedIn</a>
			<ThemeToggle />
		</div>
		<details class="mobile-menu">
			<summary>Menu <span aria-hidden="true">+</span></summary>
			<nav class="mobile-panel" aria-label="Mobile navigation">
				{links.map(({ label, href }) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
				<div class="mobile-panel-bottom">
					<a href="https://github.com/nhsiciliano" target="_blank" rel="noopener noreferrer">GitHub</a>
					<a href="https://linkedin.com/in/nicolashsiciliano" target="_blank" rel="noopener noreferrer">LinkedIn</a>
					<ThemeToggle />
				</div>
			</nav>
		</details>
	</div>
</header>

<style>
	.site-header { position: relative; z-index: 20; border-bottom: 1px solid var(--line); background: var(--surface); }
	.nav-bar { min-height: 76px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; }
	.brand { display: flex; align-items: center; gap: .65rem; width: fit-content; text-decoration: none; }
	.brand-mark { display: grid; place-items: center; width: 2.3rem; height: 2.3rem; border: 1px solid var(--accent); border-radius: 9px; color: var(--accent); font-size: .72rem; font-weight: 700; letter-spacing: -.08em; }
	.brand-name { font-size: .88rem; font-weight: 700; letter-spacing: -.04em; line-height: .94; }
	.desktop-nav, .desktop-actions { display: flex; align-items: center; gap: clamp(1.1rem, 2vw, 2rem); white-space: nowrap; }
	.desktop-actions { justify-content: end; }
	.desktop-nav a, .desktop-actions > a { color: var(--ink-soft); font-size: .85rem; text-decoration: none; transition: color .2s ease; }
	.desktop-nav a:hover, .desktop-actions > a:hover, .desktop-nav a[aria-current] { color: var(--accent); }
	.desktop-nav a[aria-current] { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .55em; }
	.mobile-menu { display: none; }
	@media (max-width: 850px) {
		.nav-bar { grid-template-columns: 1fr auto; }
		.desktop-nav, .desktop-actions { display: none; }
		.mobile-menu { display: block; }
		.mobile-menu summary { display: flex; align-items: center; gap: .7rem; padding: .65rem .9rem; border: 1px solid var(--line); border-radius: 999px; list-style: none; font-size: .85rem; cursor: pointer; }
		.mobile-menu summary::-webkit-details-marker { display: none; }
		.mobile-menu[open] summary span { transform: rotate(45deg); }
		.mobile-panel { position: absolute; top: 100%; left: 0; right: 0; display: flex; flex-direction: column; gap: 0; padding: 1rem var(--gutter) 1.5rem; border-bottom: 1px solid var(--line); background: var(--surface-raised); box-shadow: 0 20px 30px rgb(0 0 0 / .08); }
		.mobile-panel > a { padding: .7rem 0; font-size: 1.6rem; text-decoration: none; }
		.mobile-panel > a[aria-current] { color: var(--accent); }
		.mobile-panel-bottom { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem; padding-top: 1rem; margin-top: 1rem; border-top: 1px solid var(--line); }
		.mobile-panel-bottom > a { color: var(--ink-soft); font-size: .85rem; text-decoration: none; }
	}
</style>
