---
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'work'>; variant?: 'featured' | 'standard'; index?: number; }
const { project, variant = 'standard', index = 0 } = Astro.props;
const { data, id } = project;
const shortTitle = data.title.split(' · ')[0];
const mobilePreview = `/assets/preview-${id}.webp`;
---

<article class:list={['project', variant]}>
	<a class="project-image-link" href={`/work/${id}/`} aria-label={`View ${shortTitle} case study`}>
		<picture><source media="(max-width: 767px)" srcset={mobilePreview} /><img src={data.img} alt={data.img_alt || `Preview of ${shortTitle}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" width="1600" height="800" /></picture>
	</a>
	<div class="project-info">
		<div class="project-heading"><h3><a href={`/work/${id}/`}>{shortTitle}</a></h3><a class="project-arrow" href={`/work/${id}/`} aria-label={`View ${shortTitle} case study`}>↗</a></div>
		<p class="project-description">{data.description.trim()}</p>
		<p class="mono project-meta">{data.tags.slice(0, 2).join(' / ')}</p>
	</div>
</article>

<style>
	.project { min-width: 0; }
	.project-image-link { display: block; overflow: hidden; border-radius: var(--radius); background: var(--surface-muted); }
	.project img { width: 100%; aspect-ratio: 1.55; object-fit: cover; transition: transform .6s cubic-bezier(.16,1,.3,1); }
	.project-image-link:hover img { transform: scale(1.035); }
	.project.featured img { aspect-ratio: 1.85; }
	.project-info { padding-top: 1rem; }
	.project-heading { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
	h3 { font-size: clamp(1.55rem, 2.8vw, 2.5rem); }
	h3 a { text-decoration: none; }
	h3 a:hover, .project-arrow:hover { color: var(--accent); }
	.project-arrow { flex: none; font-size: 1.55rem; line-height: 1; text-decoration: none; }
	.project-description { max-width: 65ch; margin-top: .55rem; color: var(--ink-soft); font-size: .97rem; line-height: 1.5; }
	.project-meta { margin-top: .85rem; color: var(--accent); }
</style>
