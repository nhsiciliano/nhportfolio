---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';

const projects = (await getCollection('work')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const featured = projects.find((project) => project.id === 'serum-box') ?? projects[0];
const supporting = projects.filter((project) => project.id !== featured.id).slice(0, 2);
---

<BaseLayout>
	<main class="page-main" id="main">
		<section class="hero container">
			<div class="hero-copy">
				<p class="eyebrow">Full-stack developer</p>
				<h1>Complex products.<br /><em>Clear experiences.</em></h1>
				<p class="intro-copy">I’m Nicolás Siciliano. I build useful web applications for teams in science, education, and commerce.</p>
				<div class="hero-actions"><a class="button" href="/work/">View work <span aria-hidden="true">↗</span></a><a class="button button-outline" href="mailto:nhsiciliano@gmail.com">Contact</a></div>
			</div>
			<div class="hero-image"><picture><source media="(max-width: 767px)" srcset="/assets/newprofileph-640.webp" /><img src="/assets/newprofileph.webp" alt="Portrait of Nicolás Siciliano" width="1024" height="1024" fetchpriority="high" /></picture></div>
		</section>
		<section class="capabilities section-space">
			<div class="container capabilities-inner reveal">
				<div class="capabilities-heading"><h2 class="section-heading">From idea<br />to working product.</h2><p>I work across design and development to turn complex requirements into focused, reliable experiences.</p></div>
				<div class="capability-list">
					<div><h3>Product engineering</h3><p>Full-stack applications with thoughtful architecture, authentication, and resilient workflows.</p></div>
					<div><h3>Interface design</h3><p>Responsive interfaces that make detailed information easier to use and understand.</p></div>
					<div><h3>Integrations</h3><p>Billing, automation, and connected services that support a product beyond launch.</p></div>
				</div>
			</div>
		</section>
		<section class="selected section-space container" aria-labelledby="selected-title">
			<div class="selected-head reveal"><h2 id="selected-title" class="section-heading">Selected work</h2><a class="text-link" href="/work/">All projects <span aria-hidden="true">↗</span></a></div>
			<div class="selected-grid">
				<div class="selected-feature reveal"><PortfolioPreview project={featured} variant="featured" index={0} /></div>
				{supporting.map((project, index) => <div class:list={['selected-support', `selected-support-${index + 1}`, 'reveal']}><PortfolioPreview project={project} index={index + 1} /></div>)}
			</div>
		</section>
		<ContactCTA />
	</main>
</BaseLayout>

<style>
	.hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); align-items: center; gap: clamp(2rem, 6vw, 6rem); min-height: min(760px, calc(100dvh - 76px)); padding-block: 2.5rem 4rem; }
	.hero-copy { position: relative; z-index: 1; }
	.hero-copy h1 { margin-top: 1.5rem; font-size: clamp(3rem, 4.8vw, 5.6rem); white-space: nowrap; }
	.hero-copy h1 em { color: var(--accent); font-style: normal; }
	.hero-copy .intro-copy { margin-top: 1.8rem; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
	.hero-image { min-width: 0; overflow: hidden; border-radius: var(--radius); background: var(--surface-muted); }
	.hero-image img { width: 100%; height: min(640px, calc(100dvh - 150px)); min-height: 430px; object-fit: cover; object-position: center 28%; }
	.capabilities { background: var(--surface-raised); border-block: 1px solid var(--line); }
	.capabilities-inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem, 8vw, 8rem); }
	.capabilities-heading p { max-width: 36ch; margin-top: 2rem; color: var(--ink-soft); font-size: 1.12rem; }
	.capability-list > div { padding: 1.35rem 0 1.65rem; border-top: 1px solid var(--line); }
	.capability-list h3 { font-size: clamp(1.35rem, 2vw, 1.9rem); }
	.capability-list p { max-width: 48ch; margin-top: .6rem; color: var(--ink-soft); }
	.selected-head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: clamp(2rem, 5vw, 4rem); }
	.selected-head .text-link { flex: none; }
	.selected-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2.5rem, 5vw, 5rem) clamp(1.5rem, 4vw, 4rem); }
	.selected-feature { grid-column: 1 / -1; }
	.selected-support-2 { padding-top: clamp(0rem, 9vw, 9rem); }
	@media (max-width: 1050px) { .hero-copy h1 { font-size: clamp(3rem, 5.8vw, 5rem); } }
	@media (max-width: 767px) {
		.hero { grid-template-columns: 1fr; min-height: 0; padding-block: 3.75rem 5rem; }
		.hero-copy h1 { font-size: clamp(3.25rem, 9vw, 5rem); white-space: normal; }
		.hero-image { max-width: 580px; }
		.hero-image img { height: auto; min-height: 0; aspect-ratio: 1.2; }
		.capabilities-inner, .selected-grid { grid-template-columns: 1fr; }
		.selected-feature { grid-column: auto; }
		.selected-support-2 { padding-top: 0; }
		.selected-head { align-items: flex-start; flex-direction: column; }
	}
	@media (max-width: 375px) { .hero-copy h1 { font-size: 3rem; } }
</style>
