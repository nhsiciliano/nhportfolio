---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

interface Props { entry: CollectionEntry<'work'>; previous?: CollectionEntry<'work'>; next?: CollectionEntry<'work'>; }

export async function getStaticPaths() {
	const work = (await getCollection('work')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
	return work.map((entry, index) => ({ params: { slug: entry.id }, props: { entry, previous: work[index - 1], next: work[index + 1] } }));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const shortTitle = entry.data.title.split(' · ')[0];
---

<BaseLayout title={`${shortTitle} | Nicolás Siciliano`} description={entry.data.description.trim()}>
	<main class="page-main" id="main">
		<article>
			<header class="case-head container">
				<a class="back-link mono" href="/work/">← All work</a>
				<div class="case-title"><div><p class="eyebrow">Case study</p><h1>{entry.data.title}</h1></div><p>{entry.data.description.trim()}</p></div>
				<div class="case-meta mono"><span>{entry.data.tags.join(' / ')}</span><span>{entry.data.publishDate.getFullYear()}</span></div>
			</header>
			<div class="case-visual container"><img src={entry.data.img} alt={entry.data.img_alt || `Preview of ${shortTitle}`} width="1600" height="800" fetchpriority="high" /></div>
			<div class="case-body container">
				<aside class="case-aside"><p class="mono muted">Project details</p>{entry.data.projectUrl && <a class="button button-outline" href={entry.data.projectUrl} target="_blank" rel="noopener noreferrer">Visit project <span aria-hidden="true">↗</span></a>}</aside>
				<div class="prose"><Content /></div>
			</div>
		</article>
		<nav class="case-navigation container" aria-label="Other case studies">
			{previous ? <a href={`/work/${previous.id}/`}><span class="mono muted">Previous project</span><strong>{previous.data.title.split(' · ')[0]} ↗</strong></a> : <span></span>}
			{next ? <a href={`/work/${next.id}/`}><span class="mono muted">Next project</span><strong>{next.data.title.split(' · ')[0]} ↗</strong></a> : <span></span>}
		</nav>
		<ContactCTA />
	</main>
</BaseLayout>

<style>
	.case-head { padding-block: 2.5rem 3rem; }
	.back-link { color: var(--ink-soft); text-decoration: none; }
	.back-link:hover { color: var(--accent); }
	.case-title { display: grid; grid-template-columns: 1.5fr .5fr; align-items: end; gap: 3rem; margin-top: clamp(3rem, 6vw, 6rem); }
	.case-title h1 { max-width: 18ch; margin-top: 1.2rem; font-size: clamp(3rem, 6vw, 6.4rem); }
	.case-title > p { max-width: 38ch; color: var(--ink-soft); font-size: 1.1rem; }
	.case-meta { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--ink-soft); }
	.case-visual img { width: 100%; aspect-ratio: 1.8; object-fit: cover; border-radius: var(--radius); background: var(--surface-muted); }
	.case-body { display: grid; grid-template-columns: minmax(180px, 1fr) minmax(0, 2fr); gap: clamp(2rem, 8vw, 8rem); padding-block: clamp(4rem, 8vw, 8rem); }
	.case-aside { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
	.prose { max-width: 70ch; color: var(--ink-soft); font-size: 1.07rem; line-height: 1.75; overflow-wrap: anywhere; }
	.prose :global(h1), .prose :global(h2), .prose :global(h3) { color: var(--ink); margin: 2.5rem 0 1rem; line-height: 1.2; }
	.prose :global(h1) { font-size: 2.2rem; }
	.prose :global(h2) { font-size: 1.7rem; }
	.prose :global(h3) { font-size: 1.35rem; }
	.prose :global(p + p), .prose :global(p + ul), .prose :global(ul + p) { margin-top: 1.2rem; }
	.prose :global(ul) { padding-left: 1.3rem; margin-block: 1rem 1.5rem; }
	.prose :global(li + li) { margin-top: .45rem; }
	.prose :global(a) { color: var(--accent); text-underline-offset: .22em; }
	.prose :global(strong) { color: var(--ink); }
	.prose :global(code) { font-family: var(--font-mono); font-size: .84em; overflow-wrap: anywhere; }
	.case-navigation { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; padding-block: 2.5rem clamp(5rem, 9vw, 9rem); border-top: 1px solid var(--line); }
	.case-navigation a { display: flex; flex-direction: column; gap: .65rem; text-decoration: none; }
	.case-navigation a:last-child { text-align: right; }
	.case-navigation strong { font-size: clamp(1.2rem, 2vw, 2rem); font-weight: 500; }
	.case-navigation a:hover strong { color: var(--accent); }
	@media (max-width: 767px) { .case-title, .case-body { grid-template-columns: 1fr; } .case-title { gap: 1.3rem; } .case-meta { flex-wrap: wrap; } .case-navigation { gap: 1rem; } }
</style>
